# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python cache and temporary files
__pycache__/
*.py[cod]
*$py.class

# Large dataset files (should be downloaded separately or tracked via Git LFS if needed)
*.csv

# Large generated pickle files (can be regenerated by running the notebook)
*.pkl

# Environments
.venv/
venv/
env/
.env
